<script>
  window.addEventListener('load', function() {
    document.querySelectorAll('.ch-reveal').forEach(function(el, i) {
      setTimeout(function() { el.classList.add('visible'); }, i * 50);
    });
  });
  var chObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) { entry.target.classList.add('visible'); chObserver.unobserve(entry.target); }
    });
  }, { threshold: 0.07 });
  document.querySelectorAll('.ch-reveal').forEach(function(el) { chObserver.observe(el); });
</script>

